{
  "name": "ago-chat-widget",
  "version": "0.1.0",
  "private": true,
  "description": "AGO Chat embeddable widget - one <script data-site> tag, a visitor can hold a conversation.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p ux-gate/tsconfig.json",
    "lint": "eslint src ux-gate",
    "test": "vitest run",
    "test:watch": "vitest",
    "ux-gate": "playwright test --config=ux-gate/playwright.config.ts"
  },
  "dependencies": {
    "@microsoft/signalr": "^10.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^3.2.4"
  }
}
